# Copy to .env (setup.sh does it for you) and fill in. Never commit .env: it holds your secrets.

# The address of the site. Without your own domain, use your server's IP with dashes + .sslip.io, e.g. 141-147-12-34.sslip.io
DOMAIN=
APP_URL=https://${DOMAIN}
CORS_ORIGINS=https://${DOMAIN}

# Generated by setup.sh (long random values)
POSTGRES_PASSWORD=
JWT_SECRET=

# The account registered with this email becomes the administrator (use the same as on Render)
ADMIN_EMAIL=

# Market data
DATA_PROVIDER=yfinance
UNIVERSE=sp500+r1000
# ~2,000 US stocks: the S&P 500 + Nasdaq-100 + the 1,500 largest other US stocks
UNIVERSE_EXTRA=1500
# The most traded stocks of Europe and Asia (Japan, Hong Kong/China, Korea, Taiwan, India), kept apart by region
INTL_MARKETS=EU,ASIA
FINNHUB_API_KEY=

# vnicornAI: learn from every stock; plenty of memory here, so a bigger training sample
VNICORN_TRAIN_STOCKS=0
VNICORN_SAMPLES=20000

# Optional: e-mail (SMTP), Telegram and Stripe, same values as on Render
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

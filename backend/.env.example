# Copiază acest fișier ca .env și modifică valorile.
DATABASE_URL=sqlite:///./sepa.db
# Generează o cheie lungă și secretă pentru producție (ex: python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=schimba-ma-cu-o-cheie-lunga-si-secreta
# Contul care se înregistrează cu acest email devine administrator.
ADMIN_EMAIL=emailul-tau@exemplu.ro
# synthetic = date demo fără internet | yfinance = date reale gratuite (cu întârziere)
DATA_PROVIDER=yfinance
CORS_ORIGINS=http://localhost:3000

# Copy this file to .env and adjust the values.
DATABASE_URL=sqlite:///./sepa.db
# Generate a long secret key for production (e.g. python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=replace-me-with-a-long-secret-key
# The account that registers with this email becomes an administrator.
ADMIN_EMAIL=you@example.com
# synthetic = offline demo data | yfinance = free real data (delayed)
DATA_PROVIDER=yfinance
CORS_ORIGINS=http://localhost:3000

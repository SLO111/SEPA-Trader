# Copy this file to .env and adjust the values.
DATABASE_URL=sqlite:///./sepa.db
# Generate a long secret key for production (e.g. python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=replace-me-with-a-long-secret-key
# The account that registers with this email becomes an administrator.
ADMIN_EMAIL=you@example.com
# synthetic = offline demo data | yfinance = free real data (delayed)
DATA_PROVIDER=yfinance
CORS_ORIGINS=http://localhost:3000
# How often (seconds) to check alert rules in the background. 0 disables it.
ALERT_CHECK_SECONDS=300
# Optional: email notifications through any SMTP provider (Gmail, Brevo, SendGrid...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: Telegram notifications (create a bot with @BotFather and paste its token)
TELEGRAM_BOT_TOKEN=
# Payments with Stripe (leave empty to disable billing). Use test keys (sk_test_...) until you go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
# Public URL of the app (Stripe redirects back here after checkout)
APP_URL=http://localhost:3000
